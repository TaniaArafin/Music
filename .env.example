# Copy to .env and fill in. All services used here have free plans.
# Local: docker compose up -d   Production: a free Neon database URL.
DATABASE_URL="postgresql://music:music@localhost:5433/music"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional OAuth apps. Leave empty to show only the demo login.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
